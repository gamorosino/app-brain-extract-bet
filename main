#!/bin/bash

#SBATCH --job-name=app
#SBATCH --ntasks-per-node=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

# Generated by braise's scaffold_brainlife_app.py -- this is the entrypoint
# brainlife.io's orchestrator invokes directly (`./main`). It stages
# config.json into the working directory before running this.
#
# brainlife/fsl:6.0.4-patched2 ships only python2, so config.json is parsed
# here on the host (not inside the container) and `bet` is invoked directly
# instead of routing through brain_extract.py inside the container.
#
# No -R (robust center estimation): this container is missing `dc`, which
# FSL's bet shell wrapper needs internally for -R's iterative loop -- it
# fails partway through and produces an unreliable result. Plain -f works
# cleanly, confirmed against a real T1w volume.

set -e

mkdir -p t1_brain

T1=$(python3 -c "import json; print(json.load(open('config.json'))['t1'])")
FRAC=$(python3 -c "import json; print(json.load(open('config.json'))['frac'])")

singularity exec -e docker://brainlife/fsl:6.0.4-patched2 bet "$T1" t1_brain/t1 -f "$FRAC"

[ -z "$(ls -A t1_brain)" ] && echo "no output produced" && exit 1
exit 0
